# Tip MemNet access portal — empty placeholders. Never commit real values.
# Copy to a gitignored env file (for example /etc/memnet/tip-portal.env).

MEMNET_GOOGLE_CLIENT_ID=
MEMNET_GOOGLE_CLIENT_SECRET=
MEMNET_TIP_PORTAL_SECRET=
MEMNET_TIP_ADMIN_EMAIL=
MEMNET_TIP_PORTAL_BASE_URL=https://memnet.139-59-255-181.nip.io
MEMNET_TIP_PORTAL_DB=data/tip-access-portal.sqlite
MEMNET_TIP_PORTAL_BIND=127.0.0.1
MEMNET_TIP_PORTAL_PORT=8766
MEMNET_TIP_INVITE_TTL_HOURS=168
# Look-only service probes (name=target, comma-separated). Do not probe this
# portal's own /healthz from the same worker. HTTP any status (including 401)
# counts as up. tcp://host:port counts as up when the connect succeeds.
# MEMNET_STATUS_PROBES=serve=tcp://127.0.0.1:18765
# Tip MCP WWW listener (added as tip-mcp if that name is not already listed).
# MEMNET_TIP_MCP_PROBE=https://memnet.139-59-255-181.nip.io/mcp


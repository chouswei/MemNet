# Active session id (set from memnet session open stderr: MEMNET_SESSION=mn_...)
MEMNET_SESSION=

# Default session TTL in minutes when --ttl is omitted
MEMNET_SESSION_TTL_MINUTES=60

# memnet serve bind address (default 127.0.0.1:18765)
# MEMNET_SERVE_HOST=127.0.0.1
# MEMNET_SERVE_PORT=18765
# Non-loopback bind (0.0.0.0, LAN IP) requires explicit opt-in — no session token/ACL yet:
# MEMNET_SERVE_ALLOW_REMOTE=1
# TCP frame size cap (default 4 MiB):
# MEMNET_SERVE_MAX_FRAME_BYTES=4194304

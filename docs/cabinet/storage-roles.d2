# MemNet storage picture.
# storageRole (bytes past the call): working_memory, file_snapshot,
# cabinet_ego, library_locators.
# Other words on this page are labels only. They are not model attributes.

direction: down

llm: LLM {
  shape: person
}

wm: "GraphStore\nstorageRole working_memory\ndefault RAM" {
  style.fill: "#e8f4ea"
}

pin: "PinMapShapedRead\nlabel: recall window\none turn" {
  style.fill: "#f4f4f4"
}

snap: "SnapshotStore\nstorageRole file_snapshot\nexplicit save and expire-save\nare one blob" {
  style.fill: "#e8eef8"
}

cabinet: "DurableBuffer\nstorageRole cabinet_ego\nbinds exactly one of\nfake | agensgraph | neo4j\nhydrateFlushCallers=tests" {
  style.fill: "#fff4e5"
}

library: "Neo4jLibraryPort\nstorageRole library_locators\nsecond database name" {
  style.fill: "#fff4e5"
}

fake: "label: unconfigured URL\nFakeDurableAdapter\none of the three binds" {
  style.fill: "#f7f7f7"
}

hk: "HousekeepSettle\nlabel: row prune" {
  style.fill: "#f4f4f4"
}

mark: "recycle field\nlabel: row hide mark" {
  style.fill: "#f4f4f4"
}

host: "InProcessEngine / TcpServeBridge\nlabel: process host\nmany mn_* in one registry" {
  style.fill: "#f4f4f4"
}

shelf: "MemNetArchive\nlabel: retired shelf\noff ProjectMemNet load" {
  style.fill: "#f7f7f7"
}

git: "git sysml-models/\nmodel SSOT on this repo\nexisting flag, not storageRole" {
  style.fill: "#fde8e8"
}

desk: "SysMLEdge desk\nworking model only if\nSysMLEdgePrj-* and bound" {
  style.fill: "#fde8e8"
}

llm -> wm: "Commit / mutate"
wm -> pin: "Recall"
pin -> llm: "drop after the turn"
wm -> snap: "session_save\nor TTL if armed"
snap -> wm: "session_load\nloadByKnownSid"
wm -> cabinet: "flush API\nhydrateFlushCallers=tests" {
  style.stroke-dash: 3
}
cabinet -> wm: "hydrate API\nhydrateFlushCallers=tests\nego slice" {
  style.stroke-dash: 3
}
library -> wm: "locators only" {
  style.stroke-dash: 3
}
fake -> cabinet: "unconfigured bind" {
  style.stroke-dash: 3
}
hk -> wm: "prune deletes"
mark -> wm: "hide from pin_map"
host -> wm: "hosts the live graphs"
git -> wm: "Path-B ingest pins" {
  style.stroke-dash: 3
}
